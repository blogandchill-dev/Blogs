---
import Base from '../layouts/Base.astro';
import PostBody from './PostBody.astro';
import PostCard from './PostCard.astro';
import LeadMagnet from './LeadMagnet.astro';
import Sidebar from './Sidebar.astro';
import { getSite, getPublishedPosts, getAuthors, readMinutes, typeLabel, placeholderTone } from '../lib/site';
import type { Post } from '../lib/site';

const { post, related: relatedIn, noindex = false } = Astro.props as { post: Post; related?: Post[]; noindex?: boolean };
const site = await getSite();
const authors = await getAuthors();
const author = authors.find(a => a.id === post.author_id) ?? authors.find(a => a.is_editor);
const related = relatedIn ?? (await getPublishedPosts(200)).filter(p => p.id !== post.id).slice(0, 3);

const blocks = post.body ?? [];
const lede = blocks[0]?.type === 'p' ? (blocks[0] as any).text as string : null;
const rest = lede ? blocks.slice(1) : blocks;
const hero = rest.find(b => b.type === 'image_slot') as any;
const body = hero ? rest.filter(b => b !== hero) : rest;
const minutes = readMinutes(blocks);
const sections = body.filter(b => b.type === 'h2').map(b => (b as any).text as string);
const ideaHeads = sections.filter(t => !/^(what to skip|questions|faq|frequently)/i.test(t));
const updated = new Date(post.updated_at).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const pills = (post.meta?.pills as string[] | undefined) ?? [];
const rentalFriendly = blocks.some(b => b.type === 'callout' && /rental/i.test(b.label));
const url = `https://${site.domain}/${post.slug}`;
const pinHref = `https://www.pinterest.com/pin/create/button/?url=${encodeURIComponent(url)}&description=${encodeURIComponent(post.title)}`;
const nav = site.niche_plan.nav ?? [];
const crumb = nav.find(n => (n.clusters ?? []).length) ?? nav[0];

const jsonld: any[] = [{
  '@context': 'https://schema.org', '@type': 'Article',
  headline: post.title, description: post.excerpt ?? undefined,
  datePublished: post.published_at ?? undefined, dateModified: post.updated_at,
  author: { '@type': author?.is_editor ? 'Organization' : 'Person', name: author?.name ?? site.name },
  publisher: { '@type': 'Organization', name: site.name, url: `https://${site.domain}` },
  mainEntityOfPage: url,
}];
const faqs: { q: string; a: string }[] = [];
let inFaq = false, q = '';
for (const b of blocks) {
  if (b.type === 'h2') inFaq = /^(questions|faq|frequently)/i.test(b.text);
  else if (inFaq && b.type === 'h3') q = b.text;
  else if (inFaq && b.type === 'p' && q) { faqs.push({ q, a: b.text }); q = ''; }
}
if (faqs.length) jsonld.push({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
---
<Base title={post.title} description={post.excerpt ?? undefined} type="article" jsonld={jsonld} image={hero?.src ?? undefined} noindex={noindex}>
  <div class="wrap post-layout">
    <article>
      {crumb && <nav aria-label="Breadcrumb" class="eyebrow"><a href={crumb.href} style="color:inherit;text-decoration:none">{crumb.label}</a> <span aria-hidden="true">›</span> {typeLabel(post.type)}</nav>}
      <h1>{post.title}</h1>
      <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center">
        {pills.map(p => <span class="pill">{p}</span>)}
        {rentalFriendly && <span class="pill pill--info">Rental-friendly options</span>}
        <span style="font-size:13px;color:var(--muted);margin-left:auto">By <a href="/about" style="font-weight:600">{author?.name ?? site.name}</a> · Updated {updated}</span>
      </div>
      {lede && <p class="lede" style="font-size:20px;line-height:1.6;font-weight:500">{lede}</p>}
      {hero && (
        <figure style="margin:0">
          <div class="media media--framed" style={`aspect-ratio:4 / 3;background:${placeholderTone(0)}`}>
            {hero.src && <img src={hero.src} alt={hero.alt} width="1200" height="900" fetchpriority="high" />}
            {pills[0] && <span class="pill pill--tag">{pills[0]}</span>}
          </div>
          {hero.caption && <figcaption class="caption">{hero.caption}</figcaption>}
        </figure>
      )}
      <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center;border-top:2px solid var(--line);border-bottom:2px solid var(--line);padding:14px 0">
        {post.type === 'ideas' && <a class="btn btn--ink" href="#list">Jump to the list <span aria-hidden="true">↓</span></a>}
        <a class="btn" href={pinHref} rel="nofollow noopener" target="_blank">Save to Pinterest</a>
        <span style="margin-left:auto;font-size:13px;color:var(--muted)">{minutes} min read{post.type === 'ideas' && ideaHeads.length ? ` · ${ideaHeads.length} ideas` : ''}</span>
      </div>
      <div class="ad" style="height:100px" aria-label="Advertisement">Advertisement</div>
      <div id="list"></div>
      <PostBody blocks={body} numbered={post.type === 'ideas'} />
      <LeadMagnet />
      <div class="box" style="display:flex;gap:20px;align-items:center;flex-wrap:wrap">
        <div style="width:64px;height:64px;background:var(--sand);border:2px solid var(--line);flex-shrink:0"></div>
        <div style="flex:1 1 320px;display:flex;flex-direction:column;gap:4px">
          <div style="font-family:var(--font-display),sans-serif;font-weight:800;font-size:15px;text-transform:uppercase">{author?.name ?? site.name}</div>
          <p class="small">{author?.bio ?? `Ideas and sizing posts are written by the ${site.name} editorial team and checked against manufacturer specs. Buying guides carry a named author.`} <a href="/editorial-policy">How we work</a>.</p>
        </div>
      </div>
      {related.length > 0 && (
        <section style="display:flex;flex-direction:column;gap:18px">
          <div class="kicker rule" style="padding-bottom:10px;font-size:20px;letter-spacing:.02em">Keep going</div>
          <div class="grid grid--3" style="gap:20px">{related.map((p, i) => <PostCard post={p} i={i + 1} />)}</div>
        </section>
      )}
    </article>
    <Sidebar exclude={post.id} />
  </div>
  <div class="sticky-bar">
    <a class="btn btn--info" href={pinHref} rel="nofollow noopener" target="_blank">Save to Pinterest</a>
    <a class="btn" href="#list">Jump to list</a>
  </div>
</Base>
