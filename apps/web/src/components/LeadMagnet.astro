---
const { title = 'The layout sheet for this space', blurb = 'Three layouts to scale, a furniture size table, and a measuring checklist. One page, printable.', tag = 'Free download' } = Astro.props as { title?: string; blurb?: string; tag?: string };
const id = `email-${Math.random().toString(36).slice(2, 7)}`;
---
<aside class="box box--ink" style="padding:32px;display:flex;flex-wrap:wrap;gap:24px;align-items:center">
  <div style="flex:1 1 280px;display:flex;flex-direction:column;gap:8px">
    <div class="eyebrow" style="color:#A9C3B1">{tag}</div>
    <div style="font-family:var(--font-display),sans-serif;font-weight:900;font-size:28px;line-height:1.05;text-transform:uppercase">{title}</div>
    <p style="font-size:15px;line-height:1.5;color:#D8E2DB">{blurb}</p>
  </div>
  <form method="post" action="/api/subscribe" style="flex:1 1 260px;display:flex;gap:0">
    <label for={id} class="sr-only">Email</label>
    <input id={id} name="email" type="email" required placeholder="you@email.com" style="flex:1 1 auto;min-width:0;padding:14px 16px;border:2px solid #fff;background:#fff;color:var(--ink);font-size:15px;font-family:inherit" />
    <button type="submit" class="btn btn--accent" style="padding:14px 20px">Send it</button>
  </form>
</aside>
