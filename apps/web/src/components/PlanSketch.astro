---
/**
 * Plan-view sketch: a top-down drawing of the space with dimension lines.
 * Pure SVG from data, so the writer can emit one per post and the pinmaker can reuse it.
 * All measurements in feet (decimals ok). Items are rectangles in space coordinates, origin top-left.
 */
export type PlanItem = { label: string; x: number; y: number; w: number; d: number; kind?: 'seat' | 'rug' | 'table' | 'planter' | 'light' | 'other' };
export type Plan = { w: number; d: number; items: PlanItem[]; walkway?: { label: string; x: number; y: number; w: number; d: number }; note?: string };

const { plan, title, large = false } = Astro.props as { plan: Plan; title?: string; large?: boolean };
const S = large ? 56 : 44;            // px per foot
const PAD = 64;                        // room for dimension lines
const W = plan.w * S, D = plan.d * S;
const vbW = W + PAD * 2, vbH = D + PAD * 2;
const ox = PAD, oy = PAD;
const fmt = (n: number) => Number.isInteger(n) ? `${n} ft` : `${n.toFixed(1)} ft`;
const inches = (n: number) => `${Math.round(n * 12)} in`;
const fill = (k?: string) => k === 'rug' ? 'none' : k === 'seat' ? 'var(--info-tint)' : k === 'table' ? 'var(--sand)' : k === 'planter' ? 'var(--info-tint)' : 'var(--sand)';
const dash = (k?: string) => k === 'rug' ? '6 5' : undefined;
const id = `plan-${Math.random().toString(36).slice(2, 7)}`;
---
<figure class="plan" style="margin:0">
  <svg viewBox={`0 0 ${vbW} ${vbH}`} role="img" aria-labelledby={`${id}-t`} style="width:100%;height:auto;display:block;font-family:var(--font-hand),cursive;color:var(--ink)">
    <title id={`${id}-t`}>{title ?? `Plan of a ${fmt(plan.w)} by ${fmt(plan.d)} space`}</title>
    <defs>
      <pattern id={`${id}-grid`} width={S / 2} height={S / 2} patternUnits="userSpaceOnUse">
        <path d={`M ${S / 2} 0 L 0 0 0 ${S / 2}`} fill="none" stroke="var(--line)" stroke-width="0.6" />
      </pattern>
    </defs>
    <rect x={ox} y={oy} width={W} height={D} fill={`url(#${id}-grid)`} stroke="currentColor" stroke-width="2" stroke-linejoin="round" />

    {plan.walkway && (
      <g>
        <rect x={ox + plan.walkway.x * S} y={oy + plan.walkway.y * S} width={plan.walkway.w * S} height={plan.walkway.d * S} fill="var(--warn-tint)" opacity="0.55" />
        <text x={ox + (plan.walkway.x + plan.walkway.w / 2) * S} y={oy + plan.walkway.y * S + 15} text-anchor="middle" font-size="12" fill="var(--warn-ink)">{plan.walkway.label}</text>
      </g>
    )}

    {plan.items.map(it => (
      <g>
        <rect x={ox + it.x * S + 2} y={oy + it.y * S + 2} width={it.w * S - 4} height={it.d * S - 4} rx="4" fill={fill(it.kind)} stroke="currentColor" stroke-width="1.6" stroke-dasharray={dash(it.kind)} />
        {it.w * S < 56
          ? <text x={ox + (it.x + it.w / 2) * S} y={oy + (it.y + it.d / 2) * S} text-anchor="middle" font-size="11" fill="currentColor" transform={`rotate(-90 ${ox + (it.x + it.w / 2) * S} ${oy + (it.y + it.d / 2) * S})`}>{it.label}</text>
          : <text x={ox + (it.x + it.w / 2) * S} y={oy + (it.y + it.d / 2) * S + 5} text-anchor="middle" font-size={it.w * S > 90 ? 14 : 11} fill="currentColor">{it.label}</text>}
        {it.w * S > 110 && <text x={ox + (it.x + it.w / 2) * S} y={oy + (it.y + it.d / 2) * S + 22} text-anchor="middle" font-size="11" fill="var(--muted)">{inches(it.w)} × {inches(it.d)}</text>}
      </g>
    ))}

    <g stroke="currentColor" stroke-width="1.2" fill="none">
      <line x1={ox} y1={oy - 26} x2={ox + W} y2={oy - 26} />
      <line x1={ox} y1={oy - 32} x2={ox} y2={oy - 20} /><line x1={ox + W} y1={oy - 32} x2={ox + W} y2={oy - 20} />
      <line x1={ox - 26} y1={oy} x2={ox - 26} y2={oy + D} />
      <line x1={ox - 32} y1={oy} x2={ox - 20} y2={oy} /><line x1={ox - 32} y1={oy + D} x2={ox - 20} y2={oy + D} />
    </g>
    <text x={ox + W / 2} y={oy - 34} text-anchor="middle" font-size="15" fill="currentColor">{fmt(plan.w)}</text>
    <text x={ox - 36} y={oy + D / 2} text-anchor="middle" font-size="15" fill="currentColor" transform={`rotate(-90 ${ox - 36} ${oy + D / 2})`}>{fmt(plan.d)}</text>
    <text x={ox + W} y={oy + D + 30} text-anchor="end" font-size="12" fill="var(--muted)">{plan.note ?? 'plan · not to scale'}</text>
  </svg>
</figure>
