---
import type { Post } from '../lib/site';
import { placeholderTone, typeLabel } from '../lib/site';
const { post, i = 0, ratio = '4 / 3', boxed = false } = Astro.props as { post: Post; i?: number; ratio?: string; boxed?: boolean };
const pill = (post.meta?.pill as string) ?? typeLabel(post.type);
const hero = post.body?.find(b => b.type === 'image_slot') as any;
---
<a class="card" href={`/${post.slug}`} >
  <div class="media" style={`aspect-ratio:${ratio};background:${placeholderTone(i)}`}>
    {hero?.src && <img src={hero.src} alt={hero.alt ?? ''} loading="lazy" width="800" height="600" />}
    <span class="pill pill--sm pill--white">{pill}</span>
  </div>
  <div style={boxed ? 'padding:0 8px;display:flex;flex-direction:column;gap:4px' : 'display:flex;flex-direction:column;gap:4px'}>
    <div class="title">{post.title}</div>
    {post.excerpt && <div class="meta">{post.excerpt}</div>}
  </div>
</a>
