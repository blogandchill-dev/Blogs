---
import type { Post } from '../lib/site';
import { placeholderTone, typeLabel } from '../lib/site';
const { post, i = 0, ratio = '4 / 3', row = false } = Astro.props as { post: Post; i?: number; ratio?: string; row?: boolean };
const hero = post.body?.find(b => b.type === 'image_slot') as any;
const chips = (post.meta?.pills as string[] | undefined)?.slice(0, 2) ?? [];
---
<a class={`card ${row ? 'card--row' : ''}`} href={`/${post.slug}`}>
  <div class="media media--framed" style={row ? `background:${placeholderTone(i)}` : `aspect-ratio:${ratio};background:${placeholderTone(i)}`}>
    {hero?.src && <img src={hero.src} alt={hero.alt ?? ''} loading="lazy" width="800" height="600" />}
  </div>
  <div style="display:flex;flex-direction:column;gap:6px">
    <div class="title">{post.title}</div>
    {row ? <div class="meta">{typeLabel(post.type)}</div> : (
      chips.length ? <div style="display:flex;gap:6px;flex-wrap:wrap">{chips.map(c => <span class="pill pill--sm">{c}</span>)}</div> : <div class="meta">{typeLabel(post.type)}</div>
    )}
  </div>
</a>
