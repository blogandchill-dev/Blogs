---
import type { Block } from '../lib/site';
import { placeholderTone } from '../lib/site';
const { blocks, numbered = true } = Astro.props as { blocks: Block[]; numbered?: boolean };

// Number the H2s until the closing sections ("What to skip", "Questions…").
const isClosing = (t: string) => /^(what to skip|questions|faq|frequently)/i.test(t.trim());
let n = 0, img = 0, closing = false, inSkip = false, inFaq = false;
type Seg = { kind: 'block'; b: Block; num?: number; tone?: string } | { kind: 'skip-open' } | { kind: 'close' } | { kind: 'faq-open' };
const segs: Seg[] = [];
for (const b of blocks) {
  if (b.type === 'h2') {
    if (inSkip || inFaq) { segs.push({ kind: 'close' }); inSkip = inFaq = false; }
    if (isClosing(b.text)) {
      closing = true;
      if (/^what to skip/i.test(b.text)) { inSkip = true; segs.push({ kind: 'skip-open' }); }
      else { inFaq = true; segs.push({ kind: 'faq-open' }); }
      segs.push({ kind: 'block', b });
    } else {
      segs.push({ kind: 'block', b, num: numbered && !closing ? ++n : undefined });
    }
  } else if (b.type === 'image_slot') {
    segs.push({ kind: 'block', b, tone: placeholderTone(img++) });
  } else {
    segs.push({ kind: 'block', b });
  }
}
if (inSkip || inFaq) segs.push({ kind: 'close' });

const isWarn = (label: string) => /skip|avoid|don.t/i.test(label);
const isInfo = (label: string) => /rental/i.test(label);
const h2id = (s: Seg & { kind: 'block' }, text: string) =>
  s.num ? `s${s.num}` : /^what to skip/i.test(text) ? 'skip' : /^(questions|faq)/i.test(text) ? 'faq' : undefined;
const tagFromCaption = (c: string) => {
  const m = c.match(/^(\$[\d,]+(?:\s?[–-]\s?\$[\d,]+)?|about \$\d+[^.]*|under \$\d+|\d+(?:\.\d+)?\s?(?:×|x)\s?\d+(?:\.\d+)?\s?(?:ft|in)?[^.]*)/i);
  return m ? m[1].trim() : null;
};
---
<div class="prose">
  {segs.map(s => {
    if (s.kind === 'skip-open') return <Fragment set:html={'<section class="skip">'} />;
    if (s.kind === 'faq-open') return <Fragment set:html={'<section style="display:flex;flex-direction:column;gap:14px">'} />;
    if (s.kind === 'close') return <Fragment set:html={'</section>'} />;
    const b = s.b;
    switch (b.type) {
      case 'h2': return <h2 id={h2id(s, b.text)}>{s.num && <span class="num">{String(s.num).padStart(2, '0')}</span>}{b.text}</h2>;
      case 'h3': return <h3>{b.text}</h3>;
      case 'p': return <p>{b.text}</p>;
      case 'list': return b.ordered ? <ol>{b.items.map(i => <li>{i}</li>)}</ol> : <ul>{b.items.map(i => <li>{i}</li>)}</ul>;
      case 'callout': return (
        <div class={`callout ${isInfo(b.label) ? 'callout--info' : isWarn(b.label) ? 'callout--warn' : ''}`}>
          <span class="label">{b.label}</span>
          <div>{b.text}</div>
        </div>
      );
      case 'image_slot': {
        const tag = b.caption ? tagFromCaption(b.caption) : null;
        return (
          <figure>
            <div class="media" style={`aspect-ratio:4 / 3;background:${s.tone}`}>
              {b.src ? <img src={b.src} alt={b.alt} loading="lazy" width="1200" height="900" /> : null}
              {tag && <span class="pill pill--tag">{tag}</span>}
            </div>
            {b.caption && <figcaption class="caption">{b.caption}</figcaption>}
          </figure>
        );
      }
    }
  })}
</div>
