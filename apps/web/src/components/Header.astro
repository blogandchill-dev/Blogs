---
import { getSite } from '../lib/site';
const site = await getSite();
const nav = site.niche_plan.nav ?? [];
const cta = site.niche_plan.cta;
const [first, ...rest] = site.name.split(' & ');
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label={`${site.name} home`}>{rest.length ? <>{first} <span class="amp">&amp;</span> {rest.join(' & ')}</> : site.name}</a>
    <nav class="nav" aria-label="Main">
      {nav.map(n => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
      {cta && <a class="cta" href={cta.href}>{cta.label}</a>}
    </nav>
  </div>
</header>
