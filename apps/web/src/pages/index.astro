---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getSite, getPublishedPosts, placeholderTone } from '../lib/site';
const site = await getSite();
const posts = await getPublishedPosts(40);
const [lead, ...others] = posts;
const nav = site.niche_plan.nav ?? [];
const cta = site.niche_plan.cta;
const spaces = [...nav.filter(n => !/sizing/i.test(n.label)).map(n => ({ label: n.label, href: n.href })), { label: 'Rental-friendly', href: '/apartments' }];
---
<Base description="Small-space ideas with the measurements: patios, balconies, small yards and small apartments — every idea with dimensions, a price and a rental-friendly version.">
  {lead ? (
    <section class="wrap" style="padding-top:40px">
      <div class="grid" style="grid-template-columns:repeat(12,minmax(0,1fr))">
        <a href={`/${lead.slug}`} class="card" style="grid-column:span 8">
          <div class="media media--framed" style={`aspect-ratio:16 / 10;background:${placeholderTone(0)}`}>
            <span class="pill pill--accent" style="position:absolute;left:16px;top:16px;font-family:var(--font-display),sans-serif;font-weight:900;padding:8px 12px">This week</span>
          </div>
          <div style="display:flex;flex-direction:column;gap:8px">
            <h1 style="font-size:clamp(30px,3.6vw,44px)">{lead.title}</h1>
            {lead.excerpt && <p style="font-size:17px;line-height:1.55;color:#2A332D">{lead.excerpt}</p>}
          </div>
        </a>
        <div style="grid-column:span 4;display:flex;flex-direction:column;gap:20px">
          <div class="kicker rule" style="padding-bottom:8px">Also new</div>
          {others.slice(0, 4).map((p, i) => <PostCard post={p} i={i + 1} row />)}
        </div>
      </div>
    </section>
  ) : (
    <section class="wrap" style="padding-top:48px;display:flex;flex-direction:column;gap:16px;max-width:900px">
      <h1>Small spaces, measured.</h1>
      <p style="font-size:18px;line-height:1.55;color:#2A332D">Patios, balconies, small yards and small apartments — every idea with dimensions, a price range, what to skip, and a rental-friendly version. First posts are being measured; patios land first, in time for spring.</p>
    </section>
  )}

  <section class="wrap" style="padding-top:48px;display:flex;flex-direction:column;gap:20px">
    <div class="kicker rule" style="padding-bottom:8px">Start with your space</div>
    <div class="grid grid--6">
      {spaces.slice(0, 5).map((s, i) => <a href={s.href} class="card"><div class="media media--framed" style={`aspect-ratio:1 / 1;background:${placeholderTone(i)}`}></div><div class="kicker" style="text-align:center">{s.label}</div></a>)}
      <a href="/sizing" class="card"><div class="media media--framed" style="aspect-ratio:1 / 1;background:var(--info);color:#fff;display:flex;align-items:center;justify-content:center;font-family:var(--font-display),sans-serif;font-weight:900;font-size:40px">→</div><div class="kicker" style="text-align:center">Sizing guides</div></a>
    </div>
  </section>

  {others.length > 4 && (
    <section class="wrap" style="padding-top:48px;display:flex;flex-direction:column;gap:20px">
      <div class="rule" style="display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;padding-bottom:8px">
        <div class="kicker">Latest</div>
        <a href="/patios" class="kicker" style="font-size:12px;font-weight:600;color:var(--info);text-decoration:none">Everything →</a>
      </div>
      <div class="grid grid--4">{others.slice(4, 12).map((p, i) => <PostCard post={p} i={i} />)}</div>
    </section>
  )}

  {cta && (
    <section class="wrap" style="padding-top:48px">
      <div class="box box--ink" style="padding:40px;display:flex;flex-wrap:wrap;gap:32px;align-items:center">
        <div style="flex:1 1 360px;display:flex;flex-direction:column;gap:10px">
          <div class="eyebrow" style="color:#A9C3B1">The planner · coming soon</div>
          <div style="font-family:var(--font-display),sans-serif;font-weight:900;font-size:clamp(28px,3.4vw,36px);line-height:1;text-transform:uppercase;letter-spacing:-.01em">Lay out your patio or balcony before you buy a thing</div>
          <p style="font-size:16px;line-height:1.55;color:#D8E2DB">Printable templates to scale for eleven common footprints, a furniture size table, shopping checklists by budget, and a measuring guide. Made for renters and first-time owners.</p>
          <a class="btn btn--accent" href={cta.href} style="align-self:flex-start;margin-top:6px">Get the planner</a>
        </div>
        <div style="flex:1 1 320px;aspect-ratio:4 / 3;background:#C9C2B4;border:2px solid #fff"></div>
      </div>
    </section>
  )}
</Base>
